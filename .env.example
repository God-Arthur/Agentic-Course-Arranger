# 复制为 .env 后填写。`.env` 被 .gitignore 与 .dockerignore 双向排除：不进提交、不进构建上下文、不进镜像层。
#
# 这个文件有两类键，读它们的是两个不同的东西：
#   ① AI 通道：只有 planner/env_config.py 读，而且**只读仓库根的 .env 文件**（不读环境变量）。
#      所以容器里要让页面预填，必须把文件挂进去：
#      docker compose -f compose.yaml -f compose.dotenv.yaml up -d
#   ② compose 参数：docker compose 在宿主侧对本文件做变量插值，只影响构建与端口映射。

# ── ① AI 通道（现行系统唯一通路；三项不齐则本次演示直接报错退出，没有任何离线/规则替代）────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# 上游每分钟请求数上限。20 → 请求最小间隔 3 秒；留空或 0 表示不额外限流（仍受上游限额约束）。
# 超配额只会排队变慢，严重时整次演示以错误码 2 退出——不存在规则兜底。
LLM_REQUESTS_PER_MINUTE=20

# ── ② docker compose 的宿主侧参数 ────────────────────────────────────────────────
# 服务对外暴露的宿主网卡。默认 127.0.0.1：这个应用没有身份认证，改成 0.0.0.0 之前先确认网络边界。
# PLANNER_HOST_PORT=8765
# PLANNER_BIND_IP=127.0.0.1
# APP_VERSION=local

# 网络取不到 Docker Hub 时，把基础镜像换成本地已有镜像：
# BASE_IMAGE=python:3.12-slim
# 需要走国内源时的 pip 参数（只影响装 pytest 的 deps/test 阶段，runtime 一行都不装）：
# PIP_ADDITIONAL_ARGS=--index-url https://pypi.tuna.tsinghua.edu.cn/simple
#
# 构建期代理（pip 取不到包的机器才需要）。只用 BUILD_ 前缀：BuildKit 的 HTTP_PROXY 构建参数
# 不会进入容器运行环境，而如果你把 HTTP_PROXY/HTTPS_PROXY 直接写进这个文件，
# compose 插值之外的键虽然不会被注入容器，仍然容易让人误以为运行期也走代理。
# BUILD_PROXY 里的 127.0.0.1 只有配 BUILD_NETWORK=host 才指得到宿主。
# BUILD_PROXY=http://127.0.0.1:7890
# BUILD_NETWORK=host

# ── 已失效，别填：现行代码不读取 ──────────────────────────────────────────────────
# 旧 Streamlit 系统的 SOLVER_WORKERS / SOLVER_MAX_SECONDS / PLANNER_DATA_DIR / PLANNER_CACHE_DIR /
# PLANNER_LOG_DIR / PLANNER_OUTPUT_DIR / PLANNER_DATA_ROOT / OPENAI_API_KEY_FILE / LLM_KEY_FILE，
# 以及旧镜像的 APT_PACKAGES / APT_MIRROR，都随那套代码一起归档在 legacy/，现行 planner/ 与
# server/ 里零处 os.environ，填了没有任何作用。
